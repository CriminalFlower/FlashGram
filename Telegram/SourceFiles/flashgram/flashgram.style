flashgramWelcomeOpenButton: RoundButton(defaultLightButton) {
	width: -24px;
	height: 32px;
	textTop: 7px;
	radius: 16px;
}
flashgramWelcomeButton: RoundButton(defaultActiveButton) {
	height: 48px;
	textTop: 15px;
	radius: 12px;
	style: TextStyle(semiboldTextStyle) {
		font: font(15px semibold);
	}
}
