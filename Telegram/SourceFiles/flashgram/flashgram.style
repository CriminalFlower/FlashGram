using "ui/basic.style";
using "ui/widgets/widgets.style";

flashgramAboutPadding: margins(22px, 2px, 22px, 8px);
flashgramBadgesPadding: margins(22px, 4px, 22px, 10px);
flashgramBadgeHeight: 22px;
flashgramBadgeSkip: 6px;
flashgramBadgePadding: 10px;
flashgramBadgeFont: font(11px semibold);

flashgramGiftsPadding: margins(18px, 6px, 18px, 10px);
flashgramBoxGiftsPadding: margins(18px, 6px, 18px, 10px);
flashgramGiftSkip: 8px;
flashgramGiftTextHeight: 36px;
flashgramGiftRadius: 12px;
flashgramGiftEmojiSize: 44px;
flashgramGiftNameFont: font(12px semibold);
flashgramGiftNumberFont: font(11px);
flashgramGiftRarityFont: font(9px semibold);
flashgramGiftRarityHeight: 15px;
flashgramGiftRarityPadding: 6px;
flashgramGiftRarityMargin: 6px;

flashgramGiftPreviewHeight: 180px;
flashgramGiftPreviewEmojiSize: 96px;
flashgramDetailsRowSkip: 6px;
flashgramDetailsPreviewSize: size(120px, 130px);

flashgramGridSkip: 8px;
flashgramGridItemHeight: 110px;
flashgramLocalMarkHeight: 14px;
flashgramLocalMarkPadding: 5px;
flashgramLocalMarkMargin: 6px;
flashgramPlaceholderImageSize: 56px;

flashgramCardMargin: margins(18px, 4px, 18px, 8px);
flashgramCardRadius: 14px;
flashgramCardPadding: margins(16px, 12px, 16px, 12px);
flashgramCardLineSkip: 4px;
flashgramCardTitleFont: font(15px semibold);
flashgramCardTextFont: font(12px);
flashgramCardArrowFont: font(22px semibold);
flashgramBalanceCardHeight: 96px;
flashgramNewsCardHeight: 70px;
flashgramPreviewCardHeight: 160px;
flashgramCaseCardHeight: 160px;
flashgramCardPreviewSize: size(84px, 90px);
flashgramCardPreviewSkip: 8px;

flashgramBalanceLabel: FlatLabel(defaultFlatLabel) {
	textFg: activeButtonFg;
	style: TextStyle(defaultTextStyle) {
		font: font(24px semibold);
	}
}
flashgramBalanceNote: FlatLabel(defaultFlatLabel) {
	textFg: activeButtonFg;
	style: TextStyle(defaultTextStyle) {
		font: font(11px);
	}
}
flashgramBalanceTop: 34px;

flashgramRouletteHeight: 130px;
flashgramRouletteItemWidth: 100px;
flashgramRouletteItemHeight: 110px;
flashgramRouletteSkip: 8px;
flashgramRouletteMarker: 9px;
flashgramRouletteFade: 36px;
