using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";

flashgramScreenBox: Box(defaultBox) {
	buttonPadding: margins(0px, 0px, 0px, 0px);
	buttonHeight: 0px;
	margin: margins(0px, 0px, 0px, 0px);
}

flashgramWelcomeTop: 28px;
flashgramWelcomeLogoSize: 112px;
flashgramWelcomeTitle: FlatLabel(defaultFlatLabel) {
	align: align(top);
	minWidth: 300px;
	textFg: windowBoldFg;
	style: TextStyle(defaultTextStyle) {
		font: font(22px semibold);
	}
}
flashgramWelcomeTitlePadding: margins(24px, 18px, 24px, 6px);
flashgramWelcomeText: FlatLabel(defaultFlatLabel) {
	align: align(top);
	minWidth: 300px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(14px);
		lineHeight: 20px;
	}
}
